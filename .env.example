# Azure AI Foundry (OpenAI-compatible v1 endpoint of the AI Services resource)
AZURE_FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
AZURE_OPENAI_BASE_URL=https://<resource>.services.ai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=<api-key>
AZURE_LLM_DEPLOYMENT=gpt-6-luna
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-large-863247

# Neo4j dedicated to this POC (see docker-compose.yml)
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphiti-poc-pass

# Disable graphiti anonymous telemetry for the POC
GRAPHITI_TELEMETRY_ENABLED=false

# Reasoning effort for gpt-6-luna (supported: none, low, medium, high, xhigh, max)
LLM_REASONING_EFFORT=low
